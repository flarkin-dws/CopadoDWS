                <rightValue>
                    <numberValue>2025.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Revenue_on_Opportunity_0_0</targetReference>
            </connector>
            <label>2025</label>
        </rules>
        <rules>
            <name>X2026</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TicketYear</leftValueReference>
