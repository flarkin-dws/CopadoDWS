    <recordDeletes>
        <name>Delete_Payroll</name>
        <label>Delete Payroll</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Ticket_0</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Daily_Ticket__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <object>Payroll_Entry__c</object>
    </recordDeletes>
    <recordLookups>
        <name>Get_Daily_Revenue</name>
        <label>Get Daily Revenue</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Any_Daily_Revenue</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3 AND (4 OR 5)</filterLogic>
        <filters>
            <field>Job_Order__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Job_Order__r.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Date__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Date__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Resource_LU__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Assigned_Primary_Resource__r.Resource__r.Id</elementReference>
            </value>
        </filters>
        <filters>
