    <decisions>
        <description>If high pressure is changed or set to true OR if the count of daily ticket personnel with the high pressure bonus changes, the following logic in the &quot;Yes&quot; branch should run.</description>
        <name>High_Pressure_set_or_changed_to_True</name>
        <label>High Pressure set or changed to True?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.High_Pressure__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Working</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Day_shift_count_higher_than_zero</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
