                <targetReference>Update_Revenue_on_Opportunity_0_0_0</targetReference>
            </connector>
            <label>2026</label>
        </rules>
    </decisions>
    <description>This flow will replace the Daily Ticket - Trigger - After - Created or Updated flow. Logic is around High pressure/short handed bonuses and other payroll related details.
copado test.</description>
    <environments>Default</environments>
    <formulas>
        <name>IsNewFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>New</name>
        <dataType>Boolean</dataType>
        <expression>IsNew()</expression>
    </formulas>
    <formulas>
        <name>OppReduceRevenue</name>
        <dataType>Currency</dataType>
        <expression>IF(({!Get_Opportunity_0.Actual_Revenue__c}-{!$Record.Total_Amount_Daily_Ticket_Charges__c})&lt;0,0,(IF(ISBLANK({!Get_Opportunity_0.Actual_Revenue__c}),0,{!Get_Opportunity_0.Actual_Revenue__c})-{!$Record.Total_Amount_Daily_Ticket_Charges__c}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Revenue2024Formula</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!Get_Opportunity.Actual_Revenue__c}),0, {!Get_Opportunity.Actual_Revenue__c})+{!$Record.Total_Amount_Daily_Ticket_Charges__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Revenue2025Formula</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!Get_Opportunity.X2025_Revenue__c}),0, {!Get_Opportunity.X2025_Revenue__c})+{!$Record.Total_Amount_Daily_Ticket_Charges__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Revenue2026Formula</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!Get_Opportunity.X2026_Revenue__c}),0, {!Get_Opportunity.X2026_Revenue__c})+{!$Record.Total_Amount_Daily_Ticket_Charges__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TicketYear</name>
        <dataType>Number</dataType>
        <expression>YEAR({!$Record.Date__c})</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Daily Ticket - Created or Updated {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Daily Ticket - Created or Updated</label>
    <loops>
        <name>Daily_Revenue_Loop</name>
        <label>Daily Revenue Loop</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Daily_Revenue</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Daily_Revenue</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Daily_Revenue_Records</targetReference>
        </noMoreValuesConnector>
    </loops>
