    <decisions>
        <name>Night_shift_count_higher_than_0</name>
        <label>Night shift count higher than 0?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Night_Shift_HP_Bonus__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_1_to_HP_charges</targetReference>
            </connector>
            <label>Yes</label>
